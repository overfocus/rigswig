{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harness",
  "description": "Everything one tool loads for a session in one repo.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "description": "[`SCHEMA_VERSION`] at the time of writing.",
      "type": "string"
    },
    "tool": {
      "$ref": "#/$defs/Tool"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "layers": {
      "description": "Every layer the adapter knows of for this tool, present or not, highest precedence first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Layer"
      }
    },
    "packages": {
      "description": "Plugins, extensions or packs that contribute items.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Package"
      },
      "default": []
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "settings": {
      "description": "Resolved scalar settings (`model`, `approvalMode`, ...), each with the trail that decided it.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Decision"
      },
      "default": {}
    },
    "context": {
      "$ref": "#/$defs/ContextEstimate"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "default": []
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tool",
    "target",
    "layers",
    "items",
    "context",
    "coverage"
  ],
  "$defs": {
    "Tool": {
      "description": "Which tool this is, and which rules were applied.",
      "type": "object",
      "properties": {
        "id": {
          "description": "A short id: `claude-code`, `codex`, `gemini-cli`, ...",
          "type": "string"
        },
        "adapterVersion": {
          "description": "The adapter's own version: which reading of the tool's rules produced this.",
          "type": "string"
        },
        "toolVersionAssumed": {
          "description": "The tool version whose documented behaviour the adapter models, when known.",
          "type": [
            "string",
            "null"
          ]
        },
        "detectedBy": {
          "description": "Why the adapter thinks this tool is in use here (files found), as short labels.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "session": {
          "description": "The live session this interactive reading follows, when the default pick preferred a fresh repo-scoped claim.\nAbsent for explicit tools, automation, machine-wide activity and `--no-session`, and always absent on remote\nreadings, which carry nothing from this machine.",
          "anyOf": [
            {
              "$ref": "#/$defs/Session"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "adapterVersion"
      ]
    },
    "Session": {
      "description": "The live session a reading follows. Labels only, never a session id or a log's text: scope and what was seen.",
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "#/$defs/SessionScope"
        },
        "evidence": {
          "description": "What the look at session artifacts saw, as short labels.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "evidence"
      ]
    },
    "SessionScope": {
      "description": "Where a live session's activity was seen: an artifact that names this repo, or anything on this machine.",
      "oneOf": [
        {
          "description": "The harness's session artifacts name this repo, freshly touched inside the freshness window.",
          "type": "string",
          "const": "repo"
        },
        {
          "description": "The harness shows activity on this machine, but its artifacts cannot say which repo.",
          "type": "string",
          "const": "machine"
        }
      ]
    },
    "Target": {
      "type": "object",
      "properties": {
        "repo": {
          "description": "The repo, as a label (by default its folder name); full paths are opt-in.",
          "type": "string"
        },
        "os": {
          "$ref": "#/$defs/Os"
        }
      },
      "additionalProperties": false,
      "required": [
        "repo",
        "os"
      ]
    },
    "Os": {
      "type": "string",
      "enum": [
        "macos",
        "linux",
        "windows",
        "other"
      ]
    },
    "Layer": {
      "description": "One source of configuration in the precedence stack.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LayerKind"
        },
        "label": {
          "description": "Human label, e.g. \"project settings\".",
          "type": "string"
        },
        "path": {
          "description": "Where it lives, as shown to the user (`~/...` or repo-relative); absent for layers with no file.",
          "type": [
            "string",
            "null"
          ]
        },
        "present": {
          "description": "Whether anything was found there.",
          "type": "boolean"
        },
        "rank": {
          "description": "Precedence: lower wins. Unique within a harness.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "description": "`enforce` layers cannot be overridden by lower ones; `default` layers can.",
          "$ref": "#/$defs/LayerMode"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "present",
        "rank",
        "mode"
      ]
    },
    "LayerKind": {
      "type": "string",
      "enum": [
        "managed",
        "org",
        "user",
        "project",
        "local",
        "package",
        "session"
      ]
    },
    "LayerMode": {
      "type": "string",
      "enum": [
        "enforce",
        "default"
      ]
    },
    "Package": {
      "description": "A plugin, extension or pack.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PackageKind"
        },
        "source": {
          "description": "Where it came from, as a label (a marketplace name, `owner/repo`, a folder name); never a URL with a path.",
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "decidedBy": {
          "description": "The layer whose setting decided `enabled`.",
          "type": [
            "string",
            "null"
          ]
        },
        "scopes": {
          "description": "What each layer that mentions it says (on or off).",
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {}
        },
        "contributes": {
          "description": "The items it contributes.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "enabled"
      ]
    },
    "PackageKind": {
      "type": "string",
      "enum": [
        "plugin",
        "extension",
        "pack"
      ]
    },
    "Item": {
      "description": "One thing the session may load: an instruction file, an agent, a skill, a command, a hook, an MCP server or a\npermission rule.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "effective": {
          "description": "False when the item is overridden (`shadowedBy`), disabled, or otherwise not loaded.",
          "type": "boolean"
        },
        "shadowedBy": {
          "description": "The item that wins over this one (same kind and name at a higher-precedence layer).",
          "type": [
            "string",
            "null"
          ]
        },
        "load": {
          "$ref": "#/$defs/Load"
        }
      },
      "required": [
        "id",
        "name",
        "origin",
        "effective",
        "load"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "instruction"
            },
            "attrs": {
              "$ref": "#/$defs/InstructionAttrs"
            }
          },
          "required": [
            "kind",
            "attrs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agent"
            },
            "attrs": {
              "$ref": "#/$defs/AgentAttrs"
            }
          },
          "required": [
            "kind",
            "attrs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "skill"
            },
            "attrs": {
              "$ref": "#/$defs/SkillAttrs"
            }
          },
          "required": [
            "kind",
            "attrs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "command"
            },
            "attrs": {
              "$ref": "#/$defs/CommandAttrs"
            }
          },
          "required": [
            "kind",
            "attrs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hook"
            },
            "attrs": {
              "$ref": "#/$defs/HookAttrs"
            }
          },
          "required": [
            "kind",
            "attrs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "mcp"
            },
            "attrs": {
              "$ref": "#/$defs/McpAttrs"
            }
          },
          "required": [
            "kind",
            "attrs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "permission"
            },
            "attrs": {
              "$ref": "#/$defs/PermissionAttrs"
            }
          },
          "required": [
            "kind",
            "attrs"
          ]
        }
      ]
    },
    "Origin": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string"
        },
        "package": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "The file, as shown to the user (`~/...` or repo-relative).",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "layer"
      ]
    },
    "Load": {
      "description": "When an item reaches the model, and how big it is when it does.",
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/LoadWhen"
        },
        "chars": {
          "description": "Characters that load at `when` (for a skill at startup: its name and description, not its body).",
          "$ref": "#/$defs/Measure"
        },
        "contentHash": {
          "description": "SHA-256 of the item's content, hex; lets two harnesses or two runs be compared without sending content.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "when",
        "chars"
      ]
    },
    "LoadWhen": {
      "oneOf": [
        {
          "description": "Every session, before the first message.",
          "type": "string",
          "const": "startup"
        },
        {
          "description": "When a file matching the item's globs is touched.",
          "type": "string",
          "const": "on-match"
        },
        {
          "description": "When the model or the user invokes it.",
          "type": "string",
          "const": "on-invoke"
        },
        {
          "description": "Never: nothing of it enters the model's context. Either it is not loaded (disabled, shadowed, blocked), or it\nworks outside the context (a hook, a permission rule).",
          "type": "string",
          "const": "never"
        }
      ]
    },
    "Measure": {
      "description": "A number and how much to trust it.",
      "type": "object",
      "properties": {
        "value": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ]
    },
    "Confidence": {
      "description": "How a figure was obtained.",
      "oneOf": [
        {
          "description": "Reported by the tool itself.",
          "type": "string",
          "const": "native"
        },
        {
          "description": "Computed exactly from files (e.g. a character count).",
          "type": "string",
          "const": "calculated"
        },
        {
          "description": "Approximated (e.g. tokens from characters).",
          "type": "string",
          "const": "estimated"
        },
        {
          "description": "Could not be determined.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "InstructionAttrs": {
      "type": "object",
      "properties": {
        "importedBy": {
          "description": "The instruction item that imports this one (`@file` imports, nested AGENTS.md).",
          "type": [
            "string",
            "null"
          ]
        },
        "appliesTo": {
          "description": "Globs it is scoped to; empty means it applies everywhere.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "AgentAttrs": {
      "type": "object",
      "properties": {
        "tools": {
          "$ref": "#/$defs/ToolAccess"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "tools"
      ]
    },
    "ToolAccess": {
      "description": "Which tools an agent may use.",
      "oneOf": [
        {
          "description": "Every tool the session has (the agent names none).",
          "type": "string",
          "const": "all"
        },
        {
          "description": "Only these.",
          "type": "object",
          "properties": {
            "only": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "only"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SkillAttrs": {
      "type": "object",
      "properties": {
        "bodyChars": {
          "description": "Characters of the body, which load only when the skill is invoked.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "CommandAttrs": {
      "type": "object",
      "additionalProperties": false
    },
    "HookAttrs": {
      "type": "object",
      "properties": {
        "event": {
          "description": "A tool-neutral event name (`before-tool`, `after-tool`, `session-start`, `prompt-submit`, `stop`, ...).",
          "type": "string"
        },
        "nativeEvent": {
          "description": "The tool's own event name (`PreToolUse`, ...).",
          "type": "string"
        },
        "matcher": {
          "type": [
            "string",
            "null"
          ]
        },
        "handler": {
          "$ref": "#/$defs/HookHandler"
        },
        "script": {
          "description": "The script's file name only, never the command line or inline code.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "event",
        "nativeEvent",
        "handler"
      ]
    },
    "HookHandler": {
      "type": "string",
      "enum": [
        "command",
        "http",
        "prompt",
        "agent",
        "mcp-tool",
        "unknown"
      ]
    },
    "McpAttrs": {
      "type": "object",
      "properties": {
        "transport": {
          "$ref": "#/$defs/McpTransport"
        },
        "target": {
          "description": "For a URL, the scheme and host only; for a command, its file name only. Never args, env, headers or paths.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/McpState"
        }
      },
      "additionalProperties": false,
      "required": [
        "transport",
        "state"
      ]
    },
    "McpTransport": {
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "sse",
        "unknown"
      ]
    },
    "McpState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "active",
            "disabled",
            "unknown"
          ]
        },
        {
          "description": "Declared by the repo but waiting for the user's approval.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Refused by policy.",
          "type": "string",
          "const": "denied"
        }
      ]
    },
    "PermissionAttrs": {
      "type": "object",
      "properties": {
        "effect": {
          "$ref": "#/$defs/PermissionEffect"
        },
        "tool": {
          "description": "The tool the rule is about (`Bash`, `shell`, `mcp__server__tool`, ...).",
          "type": "string"
        },
        "pattern": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "effect",
        "tool"
      ]
    },
    "PermissionEffect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask"
      ]
    },
    "Decision": {
      "description": "A resolved setting and how it was decided.",
      "type": "object",
      "properties": {
        "value": {
          "description": "The value in effect; `null` when nothing sets it and the tool's default applies."
        },
        "source": {
          "description": "The layer that decided it; absent when it is the tool's default.",
          "type": [
            "string",
            "null"
          ]
        },
        "trail": {
          "description": "Every layer that had a say, highest precedence first, including the ones that lost.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TrailStep"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "value"
      ]
    },
    "TrailStep": {
      "type": "object",
      "properties": {
        "layer": {
          "type": "string"
        },
        "value": true,
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "layer",
        "value"
      ]
    },
    "ContextEstimate": {
      "description": "What loads before the first message, and how much of it could be measured.",
      "type": "object",
      "properties": {
        "chars": {
          "description": "Characters of every effective startup item. The primary unit: exact, and the same for every model.",
          "$ref": "#/$defs/Measure"
        },
        "tokens": {
          "description": "Tokens derived from `chars`; always an estimate, with a range.",
          "$ref": "#/$defs/TokenEstimate"
        },
        "notMeasured": {
          "description": "Fixed costs the tool adds that no file shows (system prompt, built-in tool schemas, MCP tool lists).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotMeasured"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "chars",
        "tokens"
      ]
    },
    "TokenEstimate": {
      "type": "object",
      "properties": {
        "method": {
          "description": "How tokens were derived, e.g. `chars/4`.",
          "type": "string"
        },
        "value": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "method",
        "value",
        "low",
        "high"
      ]
    },
    "NotMeasured": {
      "type": "object",
      "properties": {
        "what": {
          "type": "string"
        },
        "why": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "what",
        "why"
      ]
    },
    "Coverage": {
      "description": "What the adapter knows it does not model. Required and never empty: no reading of a tool is complete.",
      "type": "object",
      "properties": {
        "notModelled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "notModelled"
      ]
    },
    "Warning": {
      "type": "object",
      "properties": {
        "code": {
          "description": "A stable code, e.g. `stale-cache`, `agent-all-tools` or `incomplete-malformed-json`. The `incomplete-` prefix\nmeans the adapter could not fully read or unambiguously resolve the source; `check --strict` fails on it.",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "item": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    }
  },
  "$id": "https://github.com/overfocus/rigswig/blob/main/schema/harness.schema.json",
  "$comment": "schemaVersion 0.2.0"
}
