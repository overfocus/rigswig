{
  "name": "rigswig",
  "displayName": "rigswig",
  "description": "What a coding-agent session in this repo loads, and where each piece came from — the rigswig CLI in your editor.",
  "version": "0.0.3",
  "license": "Apache-2.0",
  "publisher": "kftcda",
  "repository": {
    "type": "git",
    "url": "https://github.com/overfocus/rigswig"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "ai-agents",
    "agents",
    "coding-agent",
    "llm",
    "context",
    "context-window",
    "tokens",
    "harness",
    "audit",
    "mcp",
    "skills",
    "subagents",
    "hooks",
    "agents-md",
    "claude-md",
    "claude",
    "claude-code",
    "codex",
    "copilot",
    "github-copilot",
    "cursor",
    "gemini",
    "gemini-cli",
    "devin",
    "deepseek",
    "hermes-agent",
    "huggingface",
    "ollama"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "rigswig",
      "properties": {
        "rigswig.executablePath": {
          "type": "string",
          "default": "rigswig",
          "description": "The rigswig binary to read with (on the PATH, or a full path). Install it with `cargo install rigswig`."
        },
        "rigswig.openInBrowser": {
          "type": "boolean",
          "default": false,
          "description": "Open the read-only page in the system browser instead of an editor panel (some editors refuse localhost frames)."
        }
      }
    },
    "commands": [
      {
        "command": "rigswig.openPage",
        "title": "rigswig: Open the page",
        "icon": "$(book)"
      },
      {
        "command": "rigswig.refresh",
        "title": "rigswig: Refresh context",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rigswig.openPage"
        },
        {
          "command": "rigswig.refresh"
        }
      ],
      "editor/title": [
        {
          "command": "rigswig.refresh",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'rigswig'"
        },
        {
          "command": "rigswig.openPage",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'rigswig'"
        }
      ]
    }
  }
}
