{
  "name": "rigswig",
  "displayName": "rigswig",
  "description": "What a coding-agent session in this repo loads, and where each piece came from — the rigswig CLI in your editor.",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "publisher": "kftcda",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0a0a0a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/overfocus/rigswig"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "ai",
    "ai-agents",
    "coding-agent",
    "llm",
    "context",
    "context-window",
    "tokens",
    "harness",
    "audit",
    "mcp",
    "skills",
    "subagents",
    "hooks",
    "agents-md",
    "claude-md",
    "claude",
    "claude-code",
    "codex",
    "copilot",
    "github-copilot",
    "cursor",
    "gemini",
    "gemini-cli",
    "devin",
    "deepseek",
    "hermes-agent",
    "huggingface",
    "ollama",
    "pi-coding-agent",
    "oh-my-pi"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "rigswig",
      "properties": {
        "rigswig.executablePath": {
          "type": "string",
          "default": "rigswig",
          "description": "The rigswig binary to read with (on the PATH, or a full path). Install it with `cargo install rigswig` or `npm install -g rigswig`. In Restricted Mode only your user settings' value is used."
        },
        "rigswig.openInBrowser": {
          "type": "boolean",
          "default": true,
          "description": "The read-only page opens in the system browser. Turn this off to open it in an editor panel instead (some editors refuse localhost frames)."
        },
        "rigswig.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Re-read the bill and the findings when a file the harness loads (CLAUDE.md, AGENTS.md, .claude/, .codex/, a skill, a settings file…) is created, changed or deleted."
        },
        "rigswig.problems": {
          "type": "string",
          "enum": [
            "workspace",
            "all",
            "off"
          ],
          "default": "workspace",
          "enumDescriptions": [
            "Findings on files inside the open folders.",
            "Findings on every file they name, user-scope and plugin files included.",
            "No findings in the Problems panel."
          ],
          "description": "Where the audit's findings appear in the Problems panel."
        },
        "rigswig.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the bill and the findings in the status bar."
        }
      }
    },
    "commands": [
      {
        "command": "rigswig.openPage",
        "title": "Open the page",
        "category": "rigswig",
        "icon": "$(book)"
      },
      {
        "command": "rigswig.refresh",
        "title": "Refresh",
        "category": "rigswig",
        "icon": "$(refresh)"
      },
      {
        "command": "rigswig.showOutput",
        "title": "Show the log",
        "category": "rigswig",
        "icon": "$(output)"
      },
      {
        "command": "rigswig.setup",
        "title": "Set up the CLI",
        "category": "rigswig"
      },
      {
        "command": "rigswig.openFile",
        "title": "Open file",
        "category": "rigswig"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rigswig.openFile",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "rigswig.refresh",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'rigswig'"
        },
        {
          "command": "rigswig.openPage",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'rigswig'"
        },
        {
          "command": "rigswig.openPage",
          "group": "navigation",
          "when": "resourceScheme == file && (resourceFilename =~ /^((CLAUDE(\\.local)?|AGENTS?(\\.local|\\.override)?|GEMINI|HERMES|SKILL|copilot-instructions)\\.md|CLAUDE\\.MD|AGENTS\\.MD|deepseek\\.md)$|^(\\.mcp\\.json|mcp\\.json|\\.(cursorrules|windsurfrules|hermes\\.md)|\\.deepseek)$/ || resourcePath =~ /[\\\\/]\\.(claude|codex|cursor|gemini|windsurf|devin|omp|hermes|pi|deepseek|deepseek-cli|agents?)[\\\\/]/)"
        }
      ],
      "view/title": [
        {
          "command": "rigswig.refresh",
          "group": "navigation@1",
          "when": "view == rigswig.findings || view == rigswig.context"
        },
        {
          "command": "rigswig.openPage",
          "group": "navigation@2",
          "when": "view == rigswig.findings || view == rigswig.context"
        },
        {
          "command": "rigswig.showOutput",
          "group": "navigation@3",
          "when": "view == rigswig.findings"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rigswig",
          "title": "rigswig",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "rigswig": [
        {
          "id": "rigswig.findings",
          "name": "Findings",
          "icon": "media/activity.svg"
        },
        {
          "id": "rigswig.context",
          "name": "What loads",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rigswig.findings",
        "contents": "Open a folder and rigswig reads what a coding-agent session there loads.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the workspace cannot choose which rigswig binary runs: rigswig.executablePath is read from your user settings only.",
      "restrictedConfigurations": [
        "rigswig.executablePath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "rigswig reads the files on disk, so a virtual workspace has nothing for it to read."
    }
  }
}
